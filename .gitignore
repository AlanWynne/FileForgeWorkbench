reports/

# ── Session-ignored artefacts: logs, scratch, non-committed data ─────────────
# All ephemeral/non-committed data lives under _ignore/ (and every subfolder).
# Script logs go to _ignore/logs/ (the former tools/logs/ was relocated there via
# tools/powershell/sweep-to-ignore.ps1). The mandatory log-capture discipline is
# the user-level steering tooling.md ("Script output -- MANDATORY log capture").
_ignore/

# ── Legacy bootstrap logs (ephemeral) ────────────────────────────────────────
bootstrap/logs/*.log

# ── cargo gate artifacts (ephemeral; the canonical gate writes here) ──────────
.gate/

# ── Dev application logs (redirected via .ffworkbench/config.toml, Phase DC) ─
.ffworkbench/logs/

# ── Temporary / scratch files ────────────────────────────────────────────────
*.log
*.tmp
FailedTest.txt
test_output.txt
Tests.txt

# ── One-off patch scripts (session-specific, not project artefacts) ──────────
patch_*.ps1
ffwb_cmp.ps1

# ── Internal documentation artefacts not intended for public repo ────────────
docs/fix_*.pdb
docs/bugs_Sample.md
FileForegeWorkbench-Primay-Screen.md

# ── IBM manual source documents (copyright IBM -- not for redistribution) ────
docs/source-documents/IBM-Manuals/

# ── Kiro AI internal config files ────────────────────────────────────────────
**/.config.kiro

# ── Python bytecode cache (tools/python helper scripts) ──────────────────────
__pycache__/
*.pyc

# ── Git worktrees (parallel feature streams; never committed) ────────────────
.worktrees/

# -- Session scratch / machine-wide logs (not project artefacts) --------------
# tools/logs/ was relocated to _ignore/logs/ (see _ignore/ above); keep the old
# path ignored in case a not-yet-migrated tool recreates it.
tools/logs/
.kiro/terminal-log/
probe.txt
worktrees-list.txt
