# FFTest Dialog Script -- Compiler Context
# Functional area: Compiler Context (Toolchain Panel)
# Validates: Req 13.2 (automated-dialog-testing), Req 15.1, 15.2 (compiler-toolchain-integration)
# Expected outcome: Compiler panel opens showing toolchain status rows

# Open Compiler panel via POM option 3
TYPE TEXT "3"
PRESS KEY ENTER

ASSERT CONTEXT IS "Compiler"

CHECKPOINT "compiler_opened"

# Verify toolchain status text is present
ASSERT TEXT EXISTS "GCC"

CHECKPOINT "compiler_gcc_visible"

# Return to POM
PRESS KEY F3

ASSERT CONTEXT IS "Home"
