# FFTest sample script -- smoke test for the command field automation ID
# Validates: Req 3.1, 3.2, 3.4 (automated-dialog-testing)

# This script is executed by: ffwb --run-script tests/dialog/smoke.fftest
# It demonstrates the FFTest scripting language without requiring a live window.

VARIABLE EXPECTED_STATUS "Ready"

# Assert the status bar is present (will fail in headless mode -- expected)
ASSERT STATUSBAR CONTAINS "${EXPECTED_STATUS}"

CHECKPOINT "smoke_initial_state"
