# Afrikaans (af) Primary Option Menu calendar chrome (CR-NR-103 Task 10). POC.
# Weekday header: Afrikaans 2-letter day abbreviations preserve the exact
# fixed-width column layout (So Ma Di Wo Do Vr Sa). The { $value } time /
# day-of-year values are pre-formatted DATA; the dotted-leader spacing is kept.
ff-desktop-pom-weekday-header = So Ma Di Wo Do Vr Sa
ff-desktop-pom-time = Tyd . . . . .: { $value }
ff-desktop-pom-day-of-year = Dag van die jaar: { $value }

# Calendar month names (B084): Afrikaans, capitalised. Keys identical to
# en/ff-desktop-pom.ftl; 01 = January .. 12 = December (localization Req 4.1).
ff-desktop-pom-month-01 = Januarie
ff-desktop-pom-month-02 = Februarie
ff-desktop-pom-month-03 = Maart
ff-desktop-pom-month-04 = April
ff-desktop-pom-month-05 = Mei
ff-desktop-pom-month-06 = Junie
ff-desktop-pom-month-07 = Julie
ff-desktop-pom-month-08 = Augustus
ff-desktop-pom-month-09 = September
ff-desktop-pom-month-10 = Oktober
ff-desktop-pom-month-11 = November
ff-desktop-pom-month-12 = Desember
