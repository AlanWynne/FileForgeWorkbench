# German (de) shell status bar (CR-NR-103 Task 10).
# DRAFT -- AI-DRAFTED, PENDING NATIVE-SPEAKER REVIEW. Keys identical to
# en/ff-desktop-shell-status.ftl; only prose translated. The banner keeps the
# product name + version verbatim (Req 4.2). Line/col/count are text placeables.
# Phase labels and CAPS are uppercase status mnemonics (translatable).

ff-desktop-shell-status-banner = FileForge Workbench v0.1.0
ff-desktop-shell-status-log-indicator = LOG!
ff-desktop-shell-status-phase-running = L{ "\u00c4" }UFT
ff-desktop-shell-status-phase-starting = STARTET
ff-desktop-shell-status-phase-shutting-down = WIRD BEENDET
ff-desktop-shell-status-phase-terminated = BEENDET
ff-desktop-shell-status-line-col = Z { $line }, Sp { $col }
ff-desktop-shell-status-line-count = { $count } Zeilen
ff-desktop-shell-status-caps = GROSS
ff-desktop-shell-status-log-degraded-hover = Protokollierung eingeschr{ "\u00e4" }nkt: { $reason }
