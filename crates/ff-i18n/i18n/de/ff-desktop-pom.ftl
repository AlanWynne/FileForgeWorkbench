# German (de) Primary Option Menu calendar chrome (CR-NR-103 Task 10).
# DRAFT -- AI-DRAFTED, PENDING NATIVE-SPEAKER REVIEW. Keys identical to
# en/ff-desktop-pom.ftl; only prose translated. The weekday header keeps the
# fixed-width 2-char-column layout (20 chars): German day abbreviations
# So Mo Di Mi Do Fr Sa. { $value } is a text placeable (pre-formatted in Rust);
# the dotted-leader prose localises and the leader spacing is preserved.

ff-desktop-pom-weekday-header = So Mo Di Mi Do Fr Sa
ff-desktop-pom-time = Zeit. . . . . : { $value }
ff-desktop-pom-day-of-year = Tag des Jahres: { $value }

# Calendar month names (B084): German, capitalised. Keys identical to
# en/ff-desktop-pom.ftl; the umlaut uses the same Fluent { "\uXXXX" } escape
# convention (localization Req 4.1). 01 = January .. 12 = December.
ff-desktop-pom-month-01 = Januar
ff-desktop-pom-month-02 = Februar
ff-desktop-pom-month-03 = M{ "\u00e4" }rz
ff-desktop-pom-month-04 = April
ff-desktop-pom-month-05 = Mai
ff-desktop-pom-month-06 = Juni
ff-desktop-pom-month-07 = Juli
ff-desktop-pom-month-08 = August
ff-desktop-pom-month-09 = September
ff-desktop-pom-month-10 = Oktober
ff-desktop-pom-month-11 = November
ff-desktop-pom-month-12 = Dezember
